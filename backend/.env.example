# Copie para .env e preencha. NUNCA commite o .env.
# Sem AI_API_KEY a aplicacao usa o provider heuristico (deterministico, offline)
# e continua funcionando de ponta a ponta.

AI_API_KEY=
AI_MODEL=claude-opus-5

# Provider remoto a usar quando AI_API_KEY estiver preenchida: "anthropic" (padrao) ou "gemini".
# AI_PROVIDER=gemini
# Para Gemini, use uma API key do Google AI Studio e um modelo como gemini-2.5-flash:
# AI_API_KEY=...
# AI_MODEL=gemini-2.5-flash
# AI_PROVIDER=gemini

# Opcional: forca o provider heuristico mesmo com chave configurada.
# AI_PROVIDER=heuristic

# Origens permitidas para o frontend (separadas por virgula).
CORS_ORIGINS=http://localhost:3000
